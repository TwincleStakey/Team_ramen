# Auto detect text files and perform LF normalization
* text=auto

# Unity 직렬화 파일은 자동 머지를 금지한다.
# 줄 단위로 섞이면 fileID 참조가 어긋난 채 "머지 성공"이 떠서 씬이 조용히 깨진다.
# -merge 를 걸면 대신 명시적 충돌로 바뀌어, 한쪽을 고르고 손으로 복구할 수 있다.
*.unity  -merge
*.prefab  -merge
*.asset  -merge
*.mat  -merge
*.anim  -merge
*.controller  -merge
*.meta  -merge

# 폰트는 바이너리
*.ttf     binary
*.otf     binary
